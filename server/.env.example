# LeadFlow server — copy to server/.env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000

# This machine runs LeadFlow's Postgres container on 5433 (host 5432 is a
# foreign instance). On a stock machine, use 5432.
DATABASE_URL=postgres://leadflow:leadflow@localhost:5433/leadflow
REDIS_URL=redis://localhost:6379

CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_ACCESS_SECRET=change-me-32-characters-minimum!!
JWT_REFRESH_SECRET=change-me-another-32-characters!!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Secrets at rest (AES-256-GCM needs a 32-byte key). Production: source from KMS.
ENCRYPTION_KEY=leadflow-dev-only-encryption-key-0001

# Free business discovery. Set a local OSM JSONL file or a permitted endpoint.
OPEN_DATA_FILE=
OVERPASS_URL=
GEOCODER_URL=
OPEN_DATA_DAILY_QUERIES=100
# API-only by default. Run dev:worker separately, or enable the combined process.
RUN_WORKERS=false
# Legacy Google settings are not used by the discovery route. No fixtures are generated.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_PLACES_STAGING=false
PLACES_QPS_PER_ORG=10

# Crawling (Phase 2)
DEFAULT_CRAWL_DELAY_MS=3000
DEFAULT_CRAWL_CONCURRENCY_PER_DOMAIN=1
PLACES_MONTHLY_CAP=5000

# ─── Instagram Auto DM (Meta Graph API) ──────────────────────────────────────
# 1. Go to https://developers.facebook.com/apps and create an app (type: Business).
# 2. Add the "Instagram Graph API" product.
# 3. Request permissions: instagram_basic, instagram_manage_messages,
#    instagram_manage_comments, pages_messaging, pages_show_list, pages_read_engagement
# 4. Set your OAuth redirect URI to: http://localhost:5173/instagram
#    (or your production domain)
META_APP_ID=
META_APP_SECRET=
# A random string — must match what you configure in the Meta webhook dashboard
META_WEBHOOK_VERIFY_TOKEN=
